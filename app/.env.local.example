# Backend utilisé par le front : "local" ou "supabase"
NEXT_PUBLIC_BACKEND=local

# URL publique du site (page /qr, liens partagés).
# À renseigner avec l'URL de déploiement, ex: https://mon-app.netlify.app
# En local, /qr utilise window.location.origin si cette variable est absente.
NEXT_PUBLIC_APP_URL=

# --- Mode LOCAL ---
# URL du serveur Express (laptop). En soirée, remplacer par l'IP locale du laptop,
# ex: http://192.168.1.50:4000  (les téléphones doivent pouvoir l'atteindre sur le même wifi)
NEXT_PUBLIC_SERVER_URL=http://localhost:4000

# Port du serveur Express (server/index.ts)
SERVER_PORT=4000

# --- Mode ONLINE (Supabase) ---
# A remplir si NEXT_PUBLIC_BACKEND=supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Heure cible du compte à rebours
TARGET_DATE=2026-06-11T16:21:00