# URL publique du site (page /qr, liens partagés).
# À renseigner avec l'URL de déploiement, ex: https://mon-app.netlify.app
# En local, /qr utilise window.location.origin si cette variable est absente.
NEXT_PUBLIC_APP_URL=

# --- Mode LOCAL ---
# URL du serveur Express (laptop). En soirée, remplacer par l'IP locale du laptop,
# ex: http://192.168.1.50:4000  (les téléphones doivent pouvoir l'atteindre sur le même wifi)
NEXT_PUBLIC_SERVER_URL=http://localhost:4000

# Port du serveur Express (server/index.ts)
SERVER_PORT=4000

# Code admin pour /admin (côté serveur uniquement — ne pas préfixer NEXT_PUBLIC_)
# Change cette valeur avant le jour J !
ADMIN_CODE=change-moi

# Heure cible du compte à rebours (format ISO, heure locale).
# Utilisée par /countdown côté client (doit être NEXT_PUBLIC_*).
NEXT_PUBLIC_TARGET_DATE=2026-06-11T16:21:00

# Ancienne variable serveur (conservée pour compatibilité scripts/Docker)
TARGET_DATE=2026-06-11T16:21:00

ALLOWED_ORIGINS=

# --- Déploiement Docker (VPS) ---
# Copier .env.docker.example → .env pour docker compose.
# Les NEXT_PUBLIC_* ci-dessus doivent aussi être dans .env au BUILD Docker
# (voir DOCKER.md). PORT et SERVER_PORT sont lues au runtime dans le conteneur.