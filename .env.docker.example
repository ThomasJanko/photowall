# Copier vers .env avant docker compose up :
#   cp .env.docker.example .env
#
# ATTENTION : les variables NEXT_PUBLIC_* sont intégrées au BUILD Next.js.
# Après les avoir modifiées, reconstruire l'image :
#   docker compose build --no-cache && docker compose up -d

# --- Build / runtime ---
NEXT_PUBLIC_APP_URL=http://203.0.113.10:3000

# URL publique de l'API Express/Socket.io (vue par les navigateurs).
# Ex: http://203.0.113.10:4000 — PAS localhost si accès depuis l'extérieur.
NEXT_PUBLIC_SERVER_URL=http://203.0.113.10:4000

# Ports exposés sur le VPS (mapping docker-compose)
PORT=3000
SERVER_PORT=4000

# Compte à rebours (/countdown)
TARGET_DATE=2026-07-18T00:00:00

# Code admin (runtime — lu par Express et les routes API Next.js)
ADMIN_CODE=change-moi
